<?xml version="1.0" encoding="utf-8"?>
<!--
  Deploy: copy everything from dist/atlas-console/browser/ (after `npm run build`) into the
  IIS site's root, including this file alongside index.html.

  Requires two IIS modules that are NOT installed by default - install via Web Platform
  Installer or the installer packages on the IIS site:
    - URL Rewrite            https://www.iis.net/downloads/microsoft/url-rewrite
    - Application Request Routing (ARR)   https://www.iis.net/downloads/microsoft/application-request-routing
  After installing ARR: open IIS Manager -> server node (not the site) -> "Application
  Request Routing Cache" -> Server Proxy Settings... -> check "Enable proxy". This step is
  the #1 thing people miss - without it, the ReverseProxyPaApi rule below 502s.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Real backend, same path-strip as the dev proxy (proxy.conf.json): /pa-api/x -> x
             on the backend. Change the target host:port if the backend developer moves it. -->
        <rule name="ReverseProxyPaApi" stopProcessing="true">
          <match url="^pa-api/(.*)" />
          <action type="Rewrite" url="http://localhost:8080/{R:1}" />
        </rule>

        <!-- Angular router (html5 pushState): anything that isn't a real file/folder and isn't
             the API route above falls back to index.html. -->
        <rule name="AngularRoutes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Content-hashed build filenames (main-XXXX.js, chunk-XXXX.js, etc.) can cache forever;
         index.html (below, via <location>) always revalidates instead, so a new deploy is
         picked up on next visit. -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
  </system.webServer>

  <!-- <location> is a top-level sibling of system.webServer, not nested inside it. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
