# UAT cluster build: uses environment.uat.ts (direct cross-origin calls to
# uat-apinoti.ultimate-pay.net, baseHref "/") -- distinct from the default Dockerfile, which
# builds environment.production.ts (reverse-proxied /pa-api, baseHref "/UltimatePay/") for the
# earlier IIS/local-Docker setup. Do not merge these; they serve different deployments.
#
# Build:  docker build -f Dockerfile.uat -t 10.225.151.51:32001/docker/atlas-console:uat .
#         (VPN off -- the base images come from Docker Hub, and the VPN cuts internet access)
# Push:   docker push 10.225.151.51:32001/docker/atlas-console:uat   (VPN on)
#         Nexus 3 registry, hosted repo "docker" -- the "/docker/" path segment is required.
# Deploy: kubectl rollout restart deployment atlas-console-uat   (on the UAT cluster master)
# Run locally: docker run -p 8080:80 10.225.151.51:32001/docker/atlas-console:uat

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build:uat

FROM nginx:1.27-alpine AS serve
# Static SPA only -- no reverse-proxy location needed here. The app calls
# https://uat-apinoti.ultimate-pay.net directly (see environment.uat.ts); that dependency is on
# the *backend's* CORS config, not on anything this container does.
COPY nginx.uat.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/atlas-console/browser /usr/share/nginx/html

EXPOSE 80
