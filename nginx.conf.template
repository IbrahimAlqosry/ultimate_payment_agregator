# Templated by the base nginx image's docker-entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf at container start — set API_BACKEND to point
# this at the real backend:
#   - same Docker network as the backend container: API_BACKEND=http://<backend-service-name>:9519
#   - backend reachable only by host/IP:            API_BACKEND=http://88.80.145.121:9519
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Real backend — same prefix + path-strip as the dev proxy (proxy.conf.json).
    location /pa-api/ {
        proxy_pass ${API_BACKEND}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The real session cookie is __Host- prefixed (Secure + no Domain attribute) — it will
        # only be set/sent correctly once this is served over HTTPS on the real deploy hostname.
    }

    # Static assets — long-cache, filenames are content-hashed by the Angular build.
    location ~* \.(?:js|css|woff2?|svg|png|jpg|jpeg|ico)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Angular router (html5 pushState) — anything else falls back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
