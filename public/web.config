<?xml version="1.0" encoding="utf-8"?>
<!--
  This file lives in public/ so Angular's build copies it into dist/atlas-console/browser/
  automatically (angular.json's assets glob: "public/**/*") - no manual copy step needed after
  `npm run build`. Just deploy the contents of dist/atlas-console/browser/ as-is.

  Requires two IIS modules that are NOT installed by default - install via Web Platform
  Installer or the installer packages on the IIS site:
    - URL Rewrite            https://www.iis.net/downloads/microsoft/url-rewrite
    - Application Request Routing (ARR)   https://www.iis.net/downloads/microsoft/application-request-routing
  After installing ARR: open IIS Manager -> server node (not the site) -> "Application
  Request Routing Cache" -> Server Proxy Settings... -> check "Enable proxy". This step is
  the #1 thing people miss - without it, the ReverseProxyPaApi rule below 502s.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Real backend, same path-strip as the dev proxy (proxy.conf.json): /pa-api/x -> x
             on the backend. Change the target host:port if the backend developer moves it.
             The backend now validates the Host header against an allowlist containing only
             "localhost:8080" (confirmed live 2026-09-14 - see docs/BACKEND_ISSUES.md) and
             rejects everything else with a blanket 400, regardless of which address actually
             receives the request. ARR does not rewrite the Host header to the proxy target by
             itself, so the serverVariables block below forces it - matching the same fix
             already applied to proxy.conf.json for local dev. REQUIRES "HTTP_HOST" to be added
             to IIS's allowed server variables first: IIS Manager -> server node (not the site)
             -> URL Rewrite -> View Server Variables... -> Add... -> "HTTP_HOST". Without that
             one-time step this rule fails to apply and 500s. -->
        <rule name="ReverseProxyPaApi" stopProcessing="true">
          <match url="^pa-api/(.*)" />
          <serverVariables>
            <set name="HTTP_HOST" value="localhost:8080" />
          </serverVariables>
          <action type="Rewrite" url="http://localhost:8080/{R:1}" />
        </rule>

        <!-- Angular router (html5 pushState): anything that isn't a real file/folder and isn't
             the API route above falls back to index.html. -->
        <rule name="AngularRoutes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Content-hashed build filenames (main-XXXX.js, chunk-XXXX.js, etc.) can cache forever;
         index.html (below, via <location>) always revalidates instead, so a new deploy is
         picked up on next visit. -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
  </system.webServer>

  <!-- <location> is a top-level sibling of system.webServer, not nested inside it. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- i18n/en.json and i18n/ar.json are NOT content-hashed (unlike main-XXXX.js), so without this
       override they'd inherit the 365-day cache above and a browser that fetched them once would
       never see a translation update again until the cache naturally expired a year later - this
       is exactly what happened 2026-09-14: two newly-added nav.* keys rendered as raw
       "nav.notificationReviews" / "nav.deliveryRecovery" because a stale cached en.json (from
       before those keys existed) was never re-fetched. Same fix as index.html: always revalidate. -->
  <location path="i18n">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
